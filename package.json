{
  "name": "navidan",
  "version": "1.0.2",
  "description": "Navigateur Web moderne, rapide et sécurisé développé sur mesure",
  "main": "src/main/main.js",
  "scripts": {
    "start": "node start.js",
    "build:linux": "npx electron-builder --linux tar.gz",
    "build:linux:all": "npx electron-builder --linux AppImage deb tar.gz",
    "build:win": "npx electron-builder --win portable nsis",
    "build:mobile": "node scripts/build-mobile.js",
    "cap:sync": "npm run build:mobile && npx cap sync android",
    "cap:build": "npm run cap:sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "adm-zip": "^0.5.16"
  },
  "build": {
    "appId": "com.navidan.browser",
    "productName": "NaviDan",
    "directories": {
      "output": "dist"
    },
    "linux": {
      "target": [
        "tar.gz",
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "icon": "assets/icon.png"
    },
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "start.js",
      "package.json",
      "node_modules/**/*"
    ]
  },
  "keywords": [
    "browser",
    "electron",
    "adblock",
    "chromium",
    "linux"
  ],
  "author": {
    "name": "NaviDan",
    "email": "contact@navidan.browser"
  },
  "license": "MIT",
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "electron": "45.2.1"
  }
}

{
  "name": "navidan",
  "version": "1.0.0",
  "description": "Navigateur Web moderne, rapide et sécurisé développé sur mesure",
  "main": "src/main/main.js",
  "scripts": {
    "start": "node start.js",
    "build:linux": "npx electron-builder --linux AppImage deb",
    "build:win": "npx electron-builder --win portable nsis"
  },
  "dependencies": {
    "adm-zip": "^0.5.16"
  },
  "build": {
    "appId": "com.navidan.browser",
    "productName": "NaviDan",
    "directories": {
      "output": "dist"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "icon": "assets/icon.png"
    },
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "start.js",
      "package.json",
      "node_modules/**/*"
    ]
  },
  "keywords": [
    "browser",
    "electron",
    "adblock",
    "chromium",
    "linux"
  ],
  "author": {
    "name": "NaviDan",
    "email": "contact@navidan.browser"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "45.2.1"
  }
}

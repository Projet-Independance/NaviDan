{
  "name": "navidan",
  "version": "1.0.4",
  "description": "Navigateur Web moderne, rapide et sécurisé développé sur mesure",
  "main": "src/main/main.js",
  "scripts": {
    "start": "node start.js",
    "build:linux": "electron-builder --linux tar.gz --publish never",
    "build:linux:all": "electron-builder --linux AppImage deb tar.gz --publish never",
    "build:win": "electron-builder --win portable nsis --publish never",
    "build:mobile": "node scripts/build-mobile.js",
    "build:store": "electron-builder --win appx --publish never",
    "cap:sync": "npm run build:mobile && npx cap sync android",
    "cap:build": "npm run cap:sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "adm-zip": "^0.5.16"
  },
  "build": {
    "appId": "com.navidan.browser",
    "productName": "NaviDan",
    "copyright": "Copyright © 2026 Projet-Independance",
    "directories": {
      "output": "dist"
    },
    "linux": {
      "target": [
        "tar.gz",
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "icon": "assets/icon.png"
    },
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    },
    "appx": {
      "applicationId": "NaviDan",
      "identityName": "PandoraEI.NaviDan",
      "publisher": "CN=6970AE15-6ECE-47A0-BFF3-0F9DC18F0953",
      "publisherDisplayName": "PandoraEI",
      "backgroundColor": "#0d1117"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "start.js",
      "package.json",
      "node_modules/**/*"
    ]
  },
  "keywords": [
    "browser",
    "electron",
    "adblock",
    "chromium",
    "linux"
  ],
  "author": {
    "name": "NaviDan",
    "email": "contact@navidan.browser"
  },
  "license": "MIT",
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "electron": "45.2.1",
    "electron-builder": "^26.18.0"
  }
}
